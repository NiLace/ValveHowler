@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

# Valve Howler's UI.
#
# A Cairo panel in an X11 window; the host drives it through the `idle`
# interface. If the host resizes the window, the pedal is fitted to it.
#
# The UI's URI is the plugin's with `#ui`, and is permanent for the same
# reason as the plugin's.
<https://nylarea.com/plugins/valvehowler#ui>
    a ui:X11UI ;
    ui:binary <valvehowler_ui.so> ;

    lv2:requiredFeature ui:idleInterface ;
    lv2:extensionData   ui:idleInterface ;

    # `ui:touch`: without it the host cannot know a knob gesture began, and
    # neither touch-mode automation nor MIDI-learn behave. Optional: a
    # host that lacks it still loads the GUI.
    #
    # `ui:scaleFactor` (via `opts:options` + `urid:map`): the host states
    # the HiDPI scale instead of the UI guessing it from Cairo's matrix.
    lv2:optionalFeature ui:noUserResize ,
                        ui:resize ,
                        ui:touch ,
                        opts:options ,
                        urid:map ;
    opts:supportedOption ui:scaleFactor ;

    # Which ports the UI subscribes to: the five it draws or edits (the
    # three knobs, the footswitch and the variant). `latency` is not
    # drawn, and subscribing to it would wake the UI for nothing.
    ui:portNotification [
        ui:plugin <https://nylarea.com/plugins/valvehowler> ;
        lv2:symbol "drive" ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://nylarea.com/plugins/valvehowler> ;
        lv2:symbol "tone" ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://nylarea.com/plugins/valvehowler> ;
        lv2:symbol "level" ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://nylarea.com/plugins/valvehowler> ;
        lv2:symbol "enabled" ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://nylarea.com/plugins/valvehowler> ;
        lv2:symbol "variant" ;
        ui:protocol ui:floatProtocol
    ] .
