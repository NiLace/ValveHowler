@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .

# Valve Howler — an overdrive modelled from the circuit.
#
# Independent product, not affiliated with any pedal manufacturer.
# The mode labels name the circuit variant each one models.
#
# The URI <https://nylarea.com/plugins/valvehowler> is a permanent
# identifier: it does not change after the first release.

# The maintainer and the licence hang off the project, not the plugin: the
# domain of doap:maintainer and doap:license is doap:Project, and
# lv2:project requires a declared doap:Project. The licence is stated here
# so the host can show it.
<https://nylarea.com/nlsounds>
    a doap:Project ;
    doap:name "NL Sounds" ;
    doap:license <http://opensource.org/licenses/gpl-3.0> ;
    doap:maintainer [ a foaf:Person ; foaf:name "NL Sounds" ;
                      foaf:mbox <mailto:nilace@nylarea.com> ] .

<https://nylarea.com/plugins/valvehowler>
    a lv2:Plugin, lv2:DistortionPlugin ;
    doap:name "Valve Howler" ;
    lv2:project <https://nylarea.com/nlsounds> ;

    # Version. A versioned LV2 resource must carry one ("Releases of
    # plugins and extensions MUST be explicitly versioned",
    # lv2core.meta.ttl).
    #
    # There is no major version in LV2: the URI is the major version.
    # "All versions of a plugin with a given URI MUST have the same set of
    # mandatory ports with respect to lv2:symbol", so the port symbols are
    # frozen; a renamed symbol makes the host load the default with no error.
    # The frozen set is these eight: in · out · drive · tone · level ·
    # latency · enabled · variant (`PORT_COUNT` in `src/nls_iface.h`).
    #
    # The public version is 1.2.0: the leading 1 is carried by the URI, and
    # the 2.0 is what these two lines say. Both must be even: "an odd minor or
    # micro version, or minor version zero, indicates that the resource is a
    # development version".
    lv2:minorVersion 4 ;
    lv2:microVersion 0 ;

    lv2:optionalFeature lv2:hardRTCapable ;

    # The link to the GUI. Declaring it in `manifest.ttl` only makes it
    # visible as a loose resource: what attaches it to the plugin is this
    # `ui:ui`. Without it, `lilv_plugin_get_uis()` returns empty and the
    # host opens the plugin with its generic interface, raising no error.
    ui:ui <https://nylarea.com/plugins/valvehowler#ui> ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        # Knob 0..1. The law (knob -> ohms) lives in the parameter layer,
        # not in the circuit model. The solver receives ohms.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "drive" ; lv2:name "Drive" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "tone" ; lv2:name "Tone" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # Latency. The host reads it to compensate the delay; without it,
        # a parallel mix with the dry signal would comb-filter.
        #
        # It is constant at run time: `NLSC_OS_TAPS - 1` samples (31 with
        # the default 32 taps), at every session rate. Published every block for robustness, not because
        # anything moves it.
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 5 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency, lv2:integer ;
        lv2:minimum 0 ; lv2:maximum 64
    ] , [
        # The GUI's 3PDT footswitch.
        #
        # `lv2:enabled` is the standard bypass designation: 1 = the plugin
        # processes, 0 = signal passes. The host sees it and can automate
        # it as bypass, which a custom boolean would not allow.
        #
        # In bypass the signal leaves delayed by the same samples `latency`
        # declares: the host compensates latency always, it does not re-ask
        # on stomp, so a straight-through dry signal would come out early
        # and comb-filter in a parallel mix.
        #
        # It does not switch dry: a 512-sample fade (~10,7 ms at 48 kHz)
        # runs both ways. The engine is biased (its resting output is not
        # zero), so a hard switch would be audible even with no signal.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "enabled" ; lv2:name "Enabled" ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        # The circuit variant: the GUI's dropdown.
        #
        # Two circuits, the ones whose values are documented by sources.
        # A row is a circuit plus a knob law, so the `L Tone` rows exist
        # without further circuits (see `nls_variantes.h`). The two output
        # resistors that separate the circuits come from three sources:
        # Keen's table, the board photo in Wampler's book (p. 255) and the
        # netlist.
        #
        # Models 9, 9RI and 5 are electrically identical in this model
        # (only the opamp would separate them, and there is no macromodel
        # for it), so they share one circuit.
        #
        # The "10" is not here: it needs a new element (`RA`) whose value
        # is disputed between sources (Keen 1 kΩ, others 220 Ω).
        #
        # It is an index, not a physical value: new variants are appended
        # at the end, or saved sessions would change circuit.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "variant" ; lv2:name "Variant" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        # The labels are `src/nls_variantes.h`'s, letter for letter. This
        # file cannot include the header, so both must be edited together.
        lv2:scalePoint [ rdfs:label "OD-8 W Tone" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "OD-9 W Tone"        ; rdf:value 1 ] ;
        # Not a new circuit: the 808's, with the tone knob's travel
        # redistributed so the dB come out even across the sweep. The circuit
        # concentrates its tone effect in the pot's last quarter (the last
        # tenth carries 67,2 % of the range) and the real G taper aggravates
        # it; this law spreads it. On this row the knob position does not
        # correspond to the real pot's rotation, which is why the faithful
        # rows keep the pot's taper and this one is its own entry.
        lv2:scalePoint [ rdfs:label "OD-8 L Tone" ; rdf:value 2 ] ;
        # The same law over the other circuit: the rows are a circuit times a
        # knob law, so both circuits get both laws. One table serves both: the
        # tone stage does not depend on the variant.
        lv2:scalePoint [ rdfs:label "OD-9 L Tone" ; rdf:value 3 ]

    ] .
